{
    "name": "laveroadmin/reporter",
    "description": "Exception reporter extension for LaveroAdmin",
    "type": "library",
    "keywords": [
        "lavero-admin",
        "exception",
        "reporter"
    ],
    "homepage": "https://bespredel.name",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=7.3",
        "laravel/framework": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "laveroadmin/laveroadmin": "^1.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": ">=6.0",
        "laravel/laravel": ">=7.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\Reporter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\Reporter\\ReporterServiceProvider"
            ]
        }
    }
}
